   "source": [
    "from pyspark.sql import functions as F\n",
    "data=[\n",
    "    (1,\"laptop\",10000),\n",
    "    (2,\"Mobile\",20000),\n",
    "    (3,\"Tablet\",15000),\n",
    "    (4,\"laptop\",5000)\n",
    "]\n",
    "columns=[\"id\",\"product\",\"price\"]\n",
    "df=spark.createDataFrame(data,columns)\n",
    "result= df.withColumn(\"Tax\",F.col(\"price\")*0.18)\n",
    "display(result)\n",
    "\n"
   ]
